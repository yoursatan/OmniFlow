{
  "name": "@omniflow/shared",
  "version": "0.1.0-pre",
  "private": false,
  "description": "OmniFlow 跨端共享 IR 类型、常量、枚举与工具函数（纯 TS，零运行时依赖）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types/*": "./src/types/*"
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "license": "GPL-3.0",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target node20 --out-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --target node20 --out-dir dist",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
