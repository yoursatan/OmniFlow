{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "vueIndentScriptAndStyle": false,
  "overrides": [
    {
      "files": ["*.md", "*.json", "*.html", "*.css", "*.vue"],
      "options": {
        "printWidth": 120,
        "singleQuote": false
      }
    }
  ]
}
