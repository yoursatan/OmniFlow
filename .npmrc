# ==========================================================
# OmniFlow pnpm 配置
# 说明：统一所有 workspace 子包的行为，保证 Windows/macOS/Linux 一致
# ==========================================================

# 1) 包管理器一致性锁定（配合 package.json > packageManager）
engine-strict=true
strict-peer-dependencies=false
auto-install-peers=true
resolve-peers-from-workspace-root=true

# 2) 国内镜像源（已在全局 pnpm config 设置，此处兜底保证新 clone 也一致）
registry=https://registry.npmmirror.com/

# 3) 符号链接策略：Windows 下尽量用 junctions 避免权限弹窗
node-linker=hoisted
prefer-symlinked-executables=false
link-workspace-packages=true

# 4) 目录：确保与 worktree 隔离，避免与主仓共享 store 冲突
store-dir=./.pnpm-store
virtual-store-dir=./node_modules/.pnpm

# 5) 性能与缓存
shared-workspace-lockfile=true
side-effects-cache=true
network-concurrency=16
fetch-concurrency=16
fetch-retries=3
fetch-retry-factor=1000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# 6) 发布/打包：仅允许 public package 发布
access=restricted
ignore-scripts=false
enable-pre-post-scripts=true

# 7) pnpm v11+ 构建脚本白名单（供应链安全）
#    pnpm v11 不再读取 package.json 的 "pnpm" 字段，必须写 .npmrc。
#    官方参数名是 camelCase（注意不是 only-built-dependencies 的 kebab）。
#    新增原生二进制依赖必须追加，否则 install 报错 ERR_PNPM_IGNORED_BUILDS。
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=esbuild-linux-64
onlyBuiltDependencies[]=esbuild-windows-64
onlyBuiltDependencies[]=esbuild-darwin-64
onlyBuiltDependencies[]=esbuild-linux-arm64
onlyBuiltDependencies[]=esbuild-darwin-arm64
onlyBuiltDependencies[]=esbuild-windows-arm64
